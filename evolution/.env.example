# Evolution API Environment Configuration
# Copy this file to .env and fill in your values
# This file should be on the server running Evolution API

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# The public URL where Evolution API is accessible
# Use your server's IP address or domain name
SERVER_URL=http://your-server-ip:8080

# API Key for authentication
# Generate a strong random key (e.g., using: openssl rand -hex 32)
API_KEY=your-secret-api-key-here

# =============================================================================
# WEBHOOK CONFIGURATION (CRITICAL!)
# =============================================================================

# Your Cloudflare Worker URL that will receive WhatsApp events
# Replace with your actual worker URL after deployment
WEBHOOK_URL=https://whatsapp-ai-chatbot.your-subdomain.workers.dev/webhook

# =============================================================================
# OPTIONAL: Redis for Production
# =============================================================================
# Uncomment if using Redis (recommended for high-volume usage)

# REDIS_ENABLED=true
# REDIS_URI=redis://localhost:6379

# =============================================================================
# NOTES
# =============================================================================
#
# After starting Evolution API:
#
# 1. Create an instance:
#    POST http://your-server:8080/instance/create
#    Header: apikey: your-secret-api-key
#    Body: { "instanceName": "whatsapp-bot", "qrcode": true }
#
# 2. Get QR code to connect WhatsApp:
#    GET http://your-server:8080/instance/qrcode/whatsapp-bot
#    Header: apikey: your-secret-api-key
#
# 3. Scan the QR code with your WhatsApp app
#
# 4. Set the following secrets in your Cloudflare Worker:
#    npx wrangler secret put EVOLUTION_API_URL
#    npx wrangler secret put EVOLUTION_API_KEY
#    npx wrangler secret put EVOLUTION_INSTANCE_NAME
#
