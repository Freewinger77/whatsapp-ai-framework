# WhatsApp AI Bot Configuration

# Server port
PORT=3000

# n8n webhook URL (required for AI responses)
# Example: http://localhost:5678/webhook/whatsapp
# Example: https://your-n8n.com/webhook/whatsapp
N8N_WEBHOOK_URL=YOUR_N8N_WEBHOOK_URL_HERE

# Optional: Admin password for web UI
# Leave empty to disable password protection
ADMIN_PASSWORD=

# API Authentication (for external platform integration)
# Generate: openssl rand -hex 32
API_KEY=

# When 1, sending SIGHUP to the Node process re-applies behaviorSettings from
# instances/instances.json without pm2 reload (same as POST /api/system/reload-behavior-from-disk).
# WASUP_SIGHUP_BEHAVIOR_RELOAD=1

# Azure Blob Storage (for media file persistence)
# Get from Azure Portal > Storage Account > Access Keys > Connection string
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=whatsapp-media

# ---- Deployment-level proxy (optional) ----
# Every instance on this deployment will route WhatsApp WebSocket + media fetch
# through this proxy UNLESS it has its own override set via the API, or a pool
# slot assigned from PROXY_POOL (which takes precedence over DEFAULT_PROXY_URL).
# Preferred: single URL
#   DEFAULT_PROXY_URL=http://user:pass@proxy.example.com:8080
#   DEFAULT_PROXY_URL=socks5://user:pass@proxy.example.com:1080
DEFAULT_PROXY_URL=

# Alternative: structured form (used only if DEFAULT_PROXY_URL is empty)
# DEFAULT_PROXY_TYPE=http        # http | https | socks4 | socks5
# DEFAULT_PROXY_HOST=
# DEFAULT_PROXY_PORT=
# DEFAULT_PROXY_USERNAME=
# DEFAULT_PROXY_PASSWORD=

# ---- Proxy pool (optional) ----
# Comma-separated proxy URLs. The first N instances created on this deployment
# auto-claim one slot each; additional instances connect direct. Deleting an
# instance returns its slot to the pool. Each instance's API override (via
# PUT /api/instances/:id/proxy) overrides its pool slot.
# Only used on wasup-uk-south, wasup-uk-west, wasup-se, wasup-fi.
#   PROXY_POOL=http://u:p@host1:port,http://u:p@host2:port,http://u:p@host3:port
PROXY_POOL=

# Region tag shown by /api/proxy and /api/health (set automatically by helper scripts)
REGION_CODE=
REGION_LABEL=
