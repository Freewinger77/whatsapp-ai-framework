# WhatsApp AI Bot Configuration

# Server port
PORT=3000

# n8n webhook URL (required for AI responses)
# Example: http://localhost:5678/webhook/whatsapp
# Example: https://your-n8n.com/webhook/whatsapp
N8N_WEBHOOK_URL=YOUR_N8N_WEBHOOK_URL_HERE

# Optional: Admin password for web UI
# Leave empty to disable password protection
ADMIN_PASSWORD=

# Optional: global deployment API key (admin / regional worker key)
API_KEY=

# Per-instance keys use wsp_v3_* format (see generateApiKey on POST /api/instances)
# Shared pepper — must match control plane WASUP_API_KEY_PEPPER in production
WASUP_API_KEY_PEPPER=

# Control plane → worker internal auth (POST /api/internal/heartbeat)
WASUP_WORKER_SHARED_SECRET=

# Docker / K8s persistent data directory (instances, auth, proxy pool)
WASUP_DATA_DIR=

# Worker topology: multi (regional pool) | single-instance (one pod per customer instance)
WASUP_WORKER_MODE=multi
WASUP_INSTANCE_ID=
WASUP_ORG_ID=
REGION_CODE=

# Allow same-origin dashboard requests without API key when API_KEY is set
# For fully open fallback workers, leave API_KEY empty instead
ALLOW_PUBLIC_DASHBOARD=false

# Password for /docs "Reveal API key" (defaults to ADMIN_PASSWORD if set)
DOCS_REVEAL_PASSWORD=

# WhatsApp auto-reconnect behavior
# Enabled by default. Recoverable disconnects preserve auth and retry with backoff.
WA_AUTO_RECONNECT_ENABLED=true
WA_RECONNECT_MAX_ATTEMPTS=8
WA_RECONNECT_BASE_DELAY_MS=5000
WA_RECONNECT_MAX_DELAY_MS=120000
# After max attempts, saved WhatsApp sessions keep retrying on this slower watchdog interval.
WA_RECONNECT_WATCHDOG_DELAY_MS=300000

# wasup smoke watchdog behavior (used by app/scripts/wasup-smoke.js)
WASUP_SMOKE_REAL_INSTANCE_CHECK=true
WASUP_SMOKE_REAL_DISCONNECTED_GRACE_MINUTES=10
# Keep false unless the watchdog host should call /connect for preserved-auth real instances.
WASUP_SMOKE_RECONNECT_REAL=false

# Proxy pool (comma-separated URLs or Webshare shorthand host:port:user:pass lines)
# Auto-assigns one slot per new instance. Persisted to instances/proxy-pool.json after first boot.
PROXY_POOL=
DEFAULT_PROXY_URL=
REGION_CODE=dev
