{
  "name": "whatsapp-ai-chatbot",
  "version": "1.0.0",
  "description": "WhatsApp AI Chatbot with RAG using Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "db:migrate": "wrangler d1 execute whatsapp-bot-db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute whatsapp-bot-db --file=./schema.sql --local",
    "kv:create": "wrangler kv:namespace create CHAT_MEMORY",
    "d1:create": "wrangler d1 create whatsapp-bot-db",
    "r2:create": "wrangler r2 bucket create content-bucket",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "openai": "^4.70.0",
    "@google/generative-ai": "^0.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.90.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "whatsapp",
    "chatbot",
    "ai",
    "rag",
    "cloudflare-workers"
  ],
  "author": "",
  "license": "MIT"
}
